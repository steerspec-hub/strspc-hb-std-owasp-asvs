{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "V07",
    "title": "Session Management"
  },
  "rule_set": {
    "version": "0.1.27",
    "timestamp": "2026-11-09T11:37:39Z",
    "hash": "blake3:b277dbcd2c8e69807c4dca44f5d18be8bf9e2eeff0b364fed98baa0024aa9ffe"
  },
  "rules": [],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V07S01",
        "title": "Session Management Documentation",
        "parent": "V07"
      },
      "rule_set": {
        "version": "0.1.3",
        "timestamp": "2026-11-09T11:37:39Z",
        "hash": "blake3:4583a05a1ea7a84ac3ceb5924216e7f9f4011f5304b7b888b22efbe459242d5a"
      },
      "rules": [
        {
          "id": "V07S01-001",
          "revision": 0,
          "state": "D",
          "body": "Verify that the user's session inactivity timeout and absolute maximum session lifetime are documented, are appropriate in combination with other controls, and that the documentation includes justification for any deviations from NIST SP 800-63B re-authentication requirements.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S01-002",
          "revision": 0,
          "state": "D",
          "body": "Verify that the documentation defines how many concurrent (parallel) sessions are allowed for one account as well as the intended behaviors and actions to be taken when the maximum number of active sessions is reached.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.1.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S01-003",
          "revision": 0,
          "state": "D",
          "body": "Verify that all systems that create and manage user sessions as part of a federated identity management ecosystem (such as SSO systems) are documented along with controls to coordinate session lifetimes, termination, and any other conditions that require re-authentication.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.1.3",
          "profiles": [
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V07S02",
        "title": "Fundamental Session Management Security",
        "parent": "V07"
      },
      "rule_set": {
        "version": "0.1.4",
        "timestamp": "2026-11-09T11:37:39Z",
        "hash": "blake3:cdab29abe070fe2d10a532b8d0f920f88ecd9e57f8cf7faac2321ebd587cd634"
      },
      "rules": [
        {
          "id": "V07S02-001",
          "revision": 0,
          "state": "D",
          "body": "Verify that the application performs all session token verification using a trusted, backend service.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.2.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S02-002",
          "revision": 0,
          "state": "D",
          "body": "Verify that the application uses either self-contained or reference tokens that are dynamically generated for session management, i.e. not using static API secrets and keys.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.2.2",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S02-003",
          "revision": 0,
          "state": "D",
          "body": "Verify that if reference tokens are used to represent user sessions, they are unique and generated using a cryptographically secure pseudo-random number generator (CSPRNG) and possess at least 128 bits of entropy.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.2.3",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S02-004",
          "revision": 0,
          "state": "D",
          "body": "Verify that the application generates a new session token on user authentication, including re-authentication, and terminates the current session token.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.2.4",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V07S03",
        "title": "Session Timeout",
        "parent": "V07"
      },
      "rule_set": {
        "version": "0.1.2",
        "timestamp": "2026-11-09T11:37:39Z",
        "hash": "blake3:a2d3c79de16141f2f569959fe11a7f0e86276551ea288cb261d6776ec1456344"
      },
      "rules": [
        {
          "id": "V07S03-001",
          "revision": 0,
          "state": "D",
          "body": "Verify that there is an inactivity timeout such that re-authentication is enforced according to risk analysis and documented security decisions.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.3.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S03-002",
          "revision": 0,
          "state": "D",
          "body": "Verify that there is an absolute maximum session lifetime such that re-authentication is enforced according to risk analysis and documented security decisions.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.3.2",
          "profiles": [
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V07S04",
        "title": "Session Termination",
        "parent": "V07"
      },
      "rule_set": {
        "version": "0.1.7",
        "timestamp": "2026-11-09T11:37:39Z",
        "hash": "blake3:65f37a6b4817ef5baee975e9ae8f969df97b127a136d218417603c2a76a1f68b"
      },
      "rules": [
        {
          "id": "V07S04-001",
          "revision": 0,
          "state": "D",
          "body": "Verify that when session termination is triggered (such as logout or expiration), the application disallows any further use of the session.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.4.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S04-002",
          "revision": 0,
          "state": "D",
          "body": "For reference tokens or stateful sessions, this means invalidating the session data at the application backend.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.4.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S04-003",
          "revision": 0,
          "state": "D",
          "body": "Applications using self-contained tokens will need a solution such as maintaining a list of terminated tokens, disallowing tokens produced before a per-user date and time or rotating a per-user signing key.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.4.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S04-004",
          "revision": 0,
          "state": "D",
          "body": "Verify that the application terminates all active sessions when a user account is disabled or deleted (such as an employee leaving the company).",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.4.2",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S04-005",
          "revision": 0,
          "state": "D",
          "body": "Verify that the application gives the option to terminate all other active sessions after a successful change or removal of any authentication factor (including password change via reset or recovery and, if present, an MFA settings update).",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.4.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S04-006",
          "revision": 0,
          "state": "D",
          "body": "Verify that all pages that require authentication have easy and visible access to logout functionality.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.4.4",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S04-007",
          "revision": 0,
          "state": "D",
          "body": "Verify that application administrators are able to terminate active sessions for an individual user or for all users.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.4.5",
          "profiles": [
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V07S05",
        "title": "Defenses Against Session Abuse",
        "parent": "V07"
      },
      "rule_set": {
        "version": "0.1.3",
        "timestamp": "2026-11-09T11:37:39Z",
        "hash": "blake3:4deb86f85a3e30984aa9f6090f120b950b86b5c5da2246d7757b8a5fedfb93fc"
      },
      "rules": [
        {
          "id": "V07S05-001",
          "revision": 0,
          "state": "D",
          "body": "Verify that the application requires full re-authentication before allowing modifications to sensitive account attributes which may affect authentication such as email address, phone number, MFA configuration, or other information used in account recovery.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.5.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S05-002",
          "revision": 0,
          "state": "D",
          "body": "Verify that users are able to view and (having authenticated again with at least one factor) terminate any or all currently active sessions.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.5.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S05-003",
          "revision": 0,
          "state": "D",
          "body": "Verify that the application requires further authentication with at least one factor or secondary verification before performing highly sensitive transactions or operations.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.5.3",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V07S06",
        "title": "Federated Re-authentication",
        "parent": "V07"
      },
      "rule_set": {
        "version": "0.1.2",
        "timestamp": "2026-11-09T11:37:39Z",
        "hash": "blake3:979bd58fd9f917422fc8cfdeb4a997dbd8dbf288764d8df2a52616b6266709ac"
      },
      "rules": [
        {
          "id": "V07S06-001",
          "revision": 0,
          "state": "D",
          "body": "Verify that session lifetime and termination between Relying Parties (RPs) and Identity Providers (IdPs) behave as documented, requiring re-authentication as necessary such as when the maximum time between IdP authentication events is reached.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.6.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V07S06-002",
          "revision": 0,
          "state": "D",
          "body": "Verify that creation of a session requires either the user's consent or an explicit action, preventing the creation of new application sessions without user interaction.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V7.6.2",
          "profiles": [
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    }
  ],
  "notes": []
}
