{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "V13",
    "title": "Configuration"
  },
  "rule_set": {
    "version": "0.1.62",
    "timestamp": "2026-11-12T12:08:46Z",
    "hash": "blake3:e1a33458e85052f33cfd03ec7c2ba41d2a5a7397aa2c69263d8259f8cf199240"
  },
  "rules": [],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V13S01",
        "title": "Configuration Documentation",
        "parent": "V13"
      },
      "rule_set": {
        "version": "0.8.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:966f2229d9adc6750ac486acb8488dc5ecc0b029d65c0aa1b6b40e9b08a6cae1"
      },
      "rules": [
        {
          "id": "V13S01-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that all communication needs for the application are documented.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S01-002",
          "revision": 0,
          "state": "P",
          "body": "This must include external services which the application relies upon and cases where an end user might be able to provide an external location to which the application will then connect.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S01-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that for each service the application uses, the documentation defines the maximum number of concurrent connections (e.g., connection pool limits) and how the application behaves when that limit is reached, including any fallback or recovery mechanisms, to prevent denial of service conditions.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.1.2",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V13S01-004",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application documentation defines resource‑management strategies for every external system or service it uses (e.g., databases, file handles, threads, HTTP connections).",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.1.3",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V13S01-005",
          "revision": 0,
          "state": "P",
          "body": "This should include resource‑release procedures, timeout settings, failure handling, and where retry logic is implemented, specifying retry limits, delays, and back‑off algorithms.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.1.3",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V13S01-006",
          "revision": 0,
          "state": "P",
          "body": "For synchronous HTTP request–response operations it should mandate short timeouts and either disable retries or strictly limit retries to prevent cascading delays and resource exhaustion.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.1.3",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V13S01-007",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application's documentation defines the secrets that are critical for the security of the application and a schedule for rotating them, based on the organization's threat model and business requirements.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.1.4",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V13S02",
        "title": "Backend Communication Configuration",
        "parent": "V13"
      },
      "rule_set": {
        "version": "0.9.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:997d1bf11449a5df07dc8477b027d81b68bfb6d61f72587b7baead108b576f3c"
      },
      "rules": [
        {
          "id": "V13S02-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that communications between backend application components that don't support the application's standard user session mechanism, including APIs, middleware, and data layers, are authenticated.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S02-002",
          "revision": 0,
          "state": "P",
          "body": "Authentication must use individual service accounts, short-term tokens, or certificate-based authentication and not unchanging credentials such as passwords, API keys, or shared accounts with privileged access.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S02-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that communications between backend application components, including local or operating system services, APIs, middleware, and data layers, are performed with accounts assigned the least necessary privileges.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S02-004",
          "revision": 0,
          "state": "P",
          "body": "Verify that if a credential has to be used for service authentication, the credential being used by the consumer is not a default credential (e.g., root/root or admin/admin).",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S02-005",
          "revision": 0,
          "state": "P",
          "body": "Verify that an allowlist is used to define the external resources or systems with which the application is permitted to communicate (e.g., for outbound requests, data loads, or file access).",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.4",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S02-006",
          "revision": 0,
          "state": "P",
          "body": "This allowlist can be implemented at the application layer, web server, firewall, or a combination of different layers.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.4",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S02-007",
          "revision": 0,
          "state": "P",
          "body": "Verify that the web or application server is configured with an allowlist of resources or systems to which the server can send requests or load data or files from.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.5",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S02-008",
          "revision": 0,
          "state": "P",
          "body": "Verify that where the application connects to separate services, it follows the documented configuration for each connection, such as maximum parallel connections, behavior when maximum allowed connections is reached, connection timeouts, and retry strategies.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.2.6",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V13S03",
        "title": "Secret Management",
        "parent": "V13"
      },
      "rule_set": {
        "version": "0.8.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:26f6ae5ae875bc20133e73648d9953fd9491ec866a921390d2ddb3d8c0353064"
      },
      "rules": [
        {
          "id": "V13S03-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that a secrets management solution, such as a key vault, is used to securely create, store, control access to, and destroy backend secrets.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.3.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S03-002",
          "revision": 0,
          "state": "P",
          "body": "These could include passwords, key material, integrations with databases and third-party systems, keys and seeds for time-based tokens, other internal secrets, and API keys.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.3.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S03-003",
          "revision": 0,
          "state": "P",
          "body": "Secrets must not be included in application source code or included in build artifacts.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.3.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S03-004",
          "revision": 0,
          "state": "P",
          "body": "For an L3 application, this must involve a hardware-backed solution such as an HSM.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.3.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S03-005",
          "revision": 0,
          "state": "P",
          "body": "Verify that access to secret assets adheres to the principle of least privilege.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.3.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S03-006",
          "revision": 0,
          "state": "P",
          "body": "Verify that all cryptographic operations are performed using an isolated security module (such as a vault or hardware security module) to securely manage and protect key material from exposure outside of the security module.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.3.3",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V13S03-007",
          "revision": 0,
          "state": "P",
          "body": "Verify that secrets are configured to expire and be rotated based on the application's documentation.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.3.4",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V13S04",
        "title": "Unintended Information Leakage",
        "parent": "V13"
      },
      "rule_set": {
        "version": "0.8.0",
        "timestamp": "2026-11-12T12:08:46Z",
        "hash": "blake3:c0afaaec6ba7f371733a2478684fa1bada44cccf5c69001d8a4875fbed3f52df"
      },
      "rules": [
        {
          "id": "V13S04-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application is deployed either without any source control metadata, including the .git or .svn folders, or in a way that these folders are inaccessible both externally and to the application itself.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.4.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S04-002",
          "revision": 0,
          "state": "P",
          "body": "Verify that debug modes are disabled for all components in production environments to prevent exposure of debugging features and information leakage.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.4.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S04-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that web servers do not expose directory listings to clients unless explicitly intended.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.4.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S04-004",
          "revision": 0,
          "state": "P",
          "body": "Verify that using the HTTP TRACE method is not supported in production environments, to avoid potential information leakage.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.4.4",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S04-005",
          "revision": 0,
          "state": "P",
          "body": "Verify that documentation (such as for internal APIs) and monitoring endpoints are not exposed unless explicitly intended.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.4.5",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V13S04-006",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application does not expose detailed version information of backend components.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.4.6",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V13S04-007",
          "revision": 0,
          "state": "P",
          "body": "Verify that the web tier is configured to only serve files with specific file extensions to prevent unintentional information, configuration, and source code leakage.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V13.4.7",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    }
  ],
  "notes": []
}
