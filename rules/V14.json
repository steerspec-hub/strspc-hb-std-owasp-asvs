{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "V14",
    "title": "Data Protection"
  },
  "rule_set": {
    "version": "0.1.45",
    "timestamp": "2026-11-12T12:08:46Z",
    "hash": "blake3:07b3ea270eb7944944f03545bc61c1fff7120fc2df2ff2452d4e5c2e80ebd6ba"
  },
  "rules": [],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V14S01",
        "title": "Data Protection Documentation",
        "parent": "V14"
      },
      "rule_set": {
        "version": "0.6.0",
        "timestamp": "2026-11-12T12:08:46Z",
        "hash": "blake3:1018387338bc48931490642d9b36c483b3d65e215c3816900b91f9eb0b52f023"
      },
      "rules": [
        {
          "id": "V14S01-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that all sensitive data created and processed by the application has been identified and classified into protection levels.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S01-002",
          "revision": 0,
          "state": "P",
          "body": "This includes data that is only encoded and therefore easily decoded, such as Base64 strings or the plaintext payload inside a JWT.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S01-003",
          "revision": 0,
          "state": "P",
          "body": "Protection levels need to take into account any data protection and privacy regulations and standards which the application is required to comply with.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S01-004",
          "revision": 0,
          "state": "P",
          "body": "Verify that all sensitive data protection levels have a documented set of protection requirements.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.1.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S01-005",
          "revision": 0,
          "state": "P",
          "body": "This must include (but not be limited to) requirements related to general encryption, integrity verification, retention, how the data is to be logged, access controls around sensitive data in logs, database-level encryption, privacy and privacy-enhancing technologies to be used, and other confidentiality requirements.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.1.2",
          "profiles": [
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V14S02",
        "title": "General Data Protection",
        "parent": "V14"
      },
      "rule_set": {
        "version": "0.13.0",
        "timestamp": "2026-11-12T12:08:46Z",
        "hash": "blake3:795387f653cb0fc99d426de1d6bd1906a53e9d746c1fe6226ba6e0d06b0211b4"
      },
      "rules": [
        {
          "id": "V14S02-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that sensitive data is only sent to the server in the HTTP message body or header fields, and that the URL and query string do not contain sensitive information, such as an API key or session token.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S02-002",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application prevents sensitive data from being cached in server components, such as load balancers and application caches, or ensures that the data is securely purged after use.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S02-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that defined sensitive data is not sent to untrusted parties (e.g., user trackers) to prevent unwanted collection of data outside of the application's control.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S02-004",
          "revision": 0,
          "state": "P",
          "body": "Verify that controls around sensitive data related to encryption, integrity verification, retention, how the data is to be logged, access controls around sensitive data in logs, privacy and privacy-enhancing technologies, are implemented as defined in the documentation for the specific data's protection level.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.4",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S02-005",
          "revision": 0,
          "state": "P",
          "body": "Verify that caching mechanisms are configured to only cache responses which have the expected content type for that resource and do not contain sensitive, dynamic content.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.5",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V14S02-006",
          "revision": 0,
          "state": "P",
          "body": "The web server should return a 404 or 302 response when a non-existent file is accessed rather than returning a different, valid file.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.5",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V14S02-007",
          "revision": 0,
          "state": "P",
          "body": "This should prevent Web Cache Deception attacks.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.5",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V14S02-008",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application only returns the minimum required sensitive data for the application's functionality.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.6",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V14S02-009",
          "revision": 0,
          "state": "P",
          "body": "For example, only returning some of the digits of a credit card number and not the full number.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.6",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V14S02-010",
          "revision": 0,
          "state": "P",
          "body": "If the complete data is required, it should be masked in the user interface unless the user specifically views it.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.6",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V14S02-011",
          "revision": 0,
          "state": "P",
          "body": "Verify that sensitive information is subject to data retention classification, ensuring that outdated or unnecessary data is deleted automatically, on a defined schedule, or as the situation requires.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.7",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V14S02-012",
          "revision": 0,
          "state": "P",
          "body": "Verify that sensitive information is removed from the metadata of user-submitted files unless storage is consented to by the user.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.2.8",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V14S03",
        "title": "Client-side Data Protection",
        "parent": "V14"
      },
      "rule_set": {
        "version": "0.5.0",
        "timestamp": "2026-11-12T12:08:46Z",
        "hash": "blake3:9aba5e227c56ecc5f18f5ce9ee02dab6dea16d7d5085b1a227b9aec1316eae3a"
      },
      "rules": [
        {
          "id": "V14S03-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that authenticated data is cleared from client storage, such as the browser DOM, after the client or session is terminated.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.3.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S03-002",
          "revision": 0,
          "state": "P",
          "body": "The 'Clear-Site-Data' HTTP response header field may be able to help with this but the client-side should also be able to clear up if the server connection is not available when the session is terminated.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.3.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S03-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application sets sufficient anti-caching HTTP response header fields (i.e., Cache-Control: no-store) so that sensitive data is not cached in browsers.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.3.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V14S03-004",
          "revision": 0,
          "state": "P",
          "body": "Verify that data stored in browser storage (such as localStorage, sessionStorage, IndexedDB, or cookies) does not contain sensitive data, with the exception of session tokens.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V14.3.3",
          "profiles": [
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    }
  ],
  "notes": []
}
