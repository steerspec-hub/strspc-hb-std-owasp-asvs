{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "V11",
    "title": "Cryptography"
  },
  "rule_set": {
    "version": "0.1.85",
    "timestamp": "2026-11-12T12:08:45Z",
    "hash": "blake3:1a3dd924d3abc344b20ff6587f805d370fc848d98e47fa66fb5c2332aeddef6d"
  },
  "rules": [],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V11S01",
        "title": "Cryptographic Inventory and Documentation",
        "parent": "V11"
      },
      "rule_set": {
        "version": "0.8.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:2e58ea41ed955954c8529c7d99e66e121775c78809077dabc20e6b10ae856ef8"
      },
      "rules": [
        {
          "id": "V11S01-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that there is a documented policy for management of cryptographic keys and a cryptographic key lifecycle that follows a key management standard such as NIST SP 800-57.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S01-002",
          "revision": 0,
          "state": "P",
          "body": "This should include ensuring that keys are not overshared (for example, with more than two entities for shared secrets and more than one entity for private keys).",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.1.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S01-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that a cryptographic inventory is performed, maintained, regularly updated, and includes all cryptographic keys, algorithms, and certificates used by the application.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.1.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S01-004",
          "revision": 0,
          "state": "P",
          "body": "It must also document where keys can and cannot be used in the system, and the types of data that can and cannot be protected using the keys.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.1.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S01-005",
          "revision": 0,
          "state": "P",
          "body": "Verify that cryptographic discovery mechanisms are employed to identify all instances of cryptography in the system, including encryption, hashing, and signing operations.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.1.3",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V11S01-006",
          "revision": 0,
          "state": "P",
          "body": "Verify that a cryptographic inventory is maintained.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.1.4",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V11S01-007",
          "revision": 0,
          "state": "P",
          "body": "This must include a documented plan that outlines the migration path to new cryptographic standards, such as post-quantum cryptography, in order to react to future threats.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.1.4",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V11S02",
        "title": "Secure Cryptography Implementation",
        "parent": "V11"
      },
      "rule_set": {
        "version": "0.9.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:87e6efb5e22c1dd865ce9b445a911a59f30d2e12499b862afeb364a7404b3869"
      },
      "rules": [
        {
          "id": "V11S02-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that industry-validated implementations (including libraries and hardware-accelerated implementations) are used for cryptographic operations.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S02-002",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application is designed with crypto agility such that random number, authenticated encryption, MAC, or hashing algorithms, key lengths, rounds, ciphers and modes can be reconfigured, upgraded, or swapped at any time, to protect against cryptographic breaks.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S02-003",
          "revision": 0,
          "state": "P",
          "body": "Similarly, it must also be possible to replace keys and passwords and re-encrypt data.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S02-004",
          "revision": 0,
          "state": "P",
          "body": "This will allow for seamless upgrades to post-quantum cryptography (PQC), once high-assurance implementations of approved PQC schemes or standards are widely available.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S02-005",
          "revision": 0,
          "state": "P",
          "body": "Verify that all cryptographic primitives utilize a minimum of 128-bits of security based on the algorithm, key size, and configuration.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S02-006",
          "revision": 0,
          "state": "P",
          "body": "For example, a 256-bit ECC key provides roughly 128 bits of security where RSA requires a 3072-bit key to achieve 128 bits of security.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S02-007",
          "revision": 0,
          "state": "P",
          "body": "Verify that all cryptographic operations are constant-time, with no 'short-circuit' operations in comparisons, calculations, or returns, to avoid leaking information.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.4",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V11S02-008",
          "revision": 0,
          "state": "P",
          "body": "Verify that all cryptographic modules fail securely, and errors are handled in a way that does not enable vulnerabilities, such as Padding Oracle attacks.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.2.5",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V11S03",
        "title": "Encryption Algorithms",
        "parent": "V11"
      },
      "rule_set": {
        "version": "0.7.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:b280c047e3679d14d6c537c5c89853e8506ae2a7aa2692f93e72901a217b0fd8"
      },
      "rules": [
        {
          "id": "V11S03-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that insecure block modes (e.g., ECB) and weak padding schemes (e.g., PKCS#1 v1.5) are not used.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.3.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S03-002",
          "revision": 0,
          "state": "P",
          "body": "Verify that only approved ciphers and modes such as AES with GCM are used.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.3.2",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S03-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that encrypted data is protected against unauthorized modification preferably by using an approved authenticated encryption method or by combining an approved encryption method with an approved MAC algorithm.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.3.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S03-004",
          "revision": 0,
          "state": "P",
          "body": "Verify that nonces, initialization vectors, and other single-use numbers are not used for more than one encryption key and data-element pair.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.3.4",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V11S03-005",
          "revision": 0,
          "state": "P",
          "body": "The method of generation must be appropriate for the algorithm being used.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.3.4",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V11S03-006",
          "revision": 0,
          "state": "P",
          "body": "Verify that any combination of an encryption algorithm and a MAC algorithm is operating in encrypt-then-MAC mode.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.3.5",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V11S04",
        "title": "Hashing and Hash-based Functions",
        "parent": "V11"
      },
      "rule_set": {
        "version": "0.10.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:9d3cec237886fc9e8b1681e940b6a2fcb9a4c4a640ddf5336f5fbc16803504fd"
      },
      "rules": [
        {
          "id": "V11S04-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that only approved hash functions are used for general cryptographic use cases, including digital signatures, HMAC, KDF, and random bit generation.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-002",
          "revision": 0,
          "state": "P",
          "body": "Disallowed hash functions, such as MD5, must not be used for any cryptographic purpose.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.1",
          "profiles": [
            "L1",
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that passwords are stored using an approved, computationally intensive, key derivation function (also known as a \"password hashing function\"), with parameter settings configured based on current guidance.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-004",
          "revision": 0,
          "state": "P",
          "body": "The settings should balance security and performance to make brute-force attacks sufficiently challenging for the required level of security.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.2",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-005",
          "revision": 0,
          "state": "P",
          "body": "Verify that hash functions used in digital signatures, as part of data authentication or data integrity are collision resistant and have appropriate bit-lengths.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-006",
          "revision": 0,
          "state": "P",
          "body": "If collision resistance is required, the output length must be at least 256 bits.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-007",
          "revision": 0,
          "state": "P",
          "body": "If only resistance to second pre-image attacks is required, the output length must be at least 128 bits.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.3",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-008",
          "revision": 0,
          "state": "P",
          "body": "Verify that the application uses approved key derivation functions with key stretching parameters when deriving secret keys from passwords.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.4",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S04-009",
          "revision": 0,
          "state": "P",
          "body": "The parameters in use must balance security and performance to prevent brute-force attacks from compromising the resulting cryptographic key.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.4.4",
          "profiles": [
            "L2",
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V11S05",
        "title": "Random Values",
        "parent": "V11"
      },
      "rule_set": {
        "version": "0.4.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:e2fb67bbd8a8e79da085c11409ca64d40a1b241926a0fc9ddeab212f99c66229"
      },
      "rules": [
        {
          "id": "V11S05-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that all random numbers and strings which are intended to be non-guessable must be generated using a cryptographically secure pseudo-random number generator (CSPRNG) and have at least 128 bits of entropy.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.5.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S05-002",
          "revision": 0,
          "state": "P",
          "body": "Note that UUIDs do not respect this condition.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.5.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S05-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that the random number generation mechanism in use is designed to work securely, even under heavy demand.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.5.2",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V11S06",
        "title": "Public Key Cryptography",
        "parent": "V11"
      },
      "rule_set": {
        "version": "0.5.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:8419aa6ec7a1b3f1fa596ae02f323a39859e3fbd21aa77642e2dae94aca5260c"
      },
      "rules": [
        {
          "id": "V11S06-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that only approved cryptographic algorithms and modes of operation are used for key generation and seeding, and digital signature generation and verification.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.6.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S06-002",
          "revision": 0,
          "state": "P",
          "body": "Key generation algorithms must not generate insecure keys vulnerable to known attacks, for example, RSA keys which are vulnerable to Fermat factorization.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.6.1",
          "profiles": [
            "L2",
            "L3"
          ]
        },
        {
          "id": "V11S06-003",
          "revision": 0,
          "state": "P",
          "body": "Verify that approved cryptographic algorithms are used for key exchange (such as Diffie-Hellman) with a focus on ensuring that key exchange mechanisms use secure parameters.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.6.2",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V11S06-004",
          "revision": 0,
          "state": "P",
          "body": "This will prevent attacks on the key establishment process which could lead to adversary-in-the-middle attacks or cryptographic breaks.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.6.2",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    },
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "V11S07",
        "title": "In-Use Data Cryptography",
        "parent": "V11"
      },
      "rule_set": {
        "version": "0.3.0",
        "timestamp": "2026-11-12T12:08:45Z",
        "hash": "blake3:a2b311b87198e474ca427aa7a01c5c94192b3598128b76abe5f8f586c6fe1202"
      },
      "rules": [
        {
          "id": "V11S07-001",
          "revision": 0,
          "state": "P",
          "body": "Verify that full memory encryption is in use that protects sensitive data while it is in use, preventing access by unauthorized users or processes.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.7.1",
          "profiles": [
            "L3"
          ]
        },
        {
          "id": "V11S07-002",
          "revision": 0,
          "state": "P",
          "body": "Verify that data minimization ensures the minimal amount of data is exposed during processing, and ensure that data is encrypted immediately after use or as soon as feasible.",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": null,
          "clause": "V11.7.2",
          "profiles": [
            "L3"
          ]
        }
      ],
      "notes": []
    }
  ],
  "notes": []
}
